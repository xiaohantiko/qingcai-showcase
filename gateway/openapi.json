{
  "openapi": "3.0.3",
  "info": {
    "title": "清财网关 API",
    "version": "1.1.0",
    "description": "清财自定义协议，不是银行/开票/税务局官方接口。内置服务仅为本机模拟器，正式适配尚未完成。金额使用十进制字符串，禁止客户端更改缴税金额。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}",
      "description": "本机测试；App自动分配端口",
      "variables": {
        "port": {
          "default": "18765"
        }
      }
    }
  ],
  "security": [
    {
      "GatewayBearer": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "security": [],
        "summary": "进程健康检查",
        "responses": {
          "200": {
            "description": "无敏感信息的健康状态"
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "summary": "检查环境及已授权接口能力",
        "responses": {
          "200": {
            "description": "成功响应，环境由响应头校验",
            "headers": {
              "X-Qingcai-Environment": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "sandbox",
                    "live"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          },
          "401": {
            "description": "错误，不自动重提写操作",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
