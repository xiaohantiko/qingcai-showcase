  "components": {
    "securitySchemes": {
      "GatewayBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Operation": {
        "type": "object",
        "required": [
          "id",
          "environment",
          "kind",
          "status",
          "payload",
          "payloadDigest",
          "attempts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "environment": {
            "type": "string",
            "enum": [
              "sandbox",
              "live"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "bankSync",
              "invoiceIssue",
              "taxDeclaration",
              "taxPayment"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "awaitingApproval",
              "queued",
              "submitting",
              "pending",
              "succeeded",
              "failed",
              "unknown",
              "cancelled"
            ]
          },
          "idempotencyKey": {
            "type": "string"
          },
          "payload": {
            "type": "object",
            "additionalProperties": true
          },
          "payloadDigest": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "approvalExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "attempts": {
            "type": "integer"
          },
          "providerReference": {
            "type": "string"
          },
          "receipt": {
            "type": "object",
            "additionalProperties": true
          },
          "errorCode": {
            "type": "string"
          }
        }
      },
      "Draft": {
        "type": "object",
        "required": [
          "kind",
          "payload"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "bankSync",
              "invoiceIssue",
              "taxDeclaration",
              "taxPayment"
            ]
          },
          "payload": {
            "type": "object",
            "additionalProperties": true,
            "description": "参见 gateway/examples。税务模板仅为测试，不是法定申报表。"
          }
        }
      },
      "Approval": {
        "type": "object",
        "required": [
          "payloadDigest",
          "acknowledged"
        ],
        "properties": {
          "payloadDigest": {
            "type": "string"
          },
          "acknowledged": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "properties": {
          "apiVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "environment": {
            "type": "string",
            "enum": [
              "sandbox",
              "live"
            ]
          },
          "provider": {
            "type": "string"
          },
          "productionReady": {
            "type": "boolean"
          },
          "availableOperations": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "bankSync",
                "invoiceIssue",
                "taxDeclaration",
                "taxPayment"
              ]
            }
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
